# Public, non-secret settings. The matching values live in fly.toml.
APP_URL=https://id.rati.chat
DB_CONNECTION_STRING=/app/data/pocket-id.db
TRUST_PROXY=true
ALLOW_INSECURE_CALLBACK_URLS=false
EMAIL_ONE_TIME_ACCESS_AS_UNAUTHENTICATED_ENABLED=false
WEBAUTHN_USER_VERIFICATION=required
WEBAUTHN_ALLOW_SYNCED_PASSKEYS=true
WEBAUTHN_AUTHENTICATOR_ATTACHMENT=any

# Set this only through Fly secrets. Keep a recovery copy outside Fly.
ENCRYPTION_KEY=<generate-a-random-32-byte-value>
