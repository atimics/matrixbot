@@ -0,0 +1,26 @@
+/** Keep signup return paths on the local OIDC flow. */
+export function signupReturnPath(/** @type {string | null | undefined} */ value) {
+	if (!value || !value.startsWith('/') || value.startsWith('//') || /[\\\r\n]/.test(value)) {
+		return '/settings';
+	}
+	const url = new URL(value, 'https://signup.invalid');
+	if (
+		url.origin !== 'https://signup.invalid' ||
+		!['/authorize', '/interaction'].includes(url.pathname) ||
+		url.hash
+	) {
+		return '/settings';
+	}
+	return url.pathname + url.search;
+}
+
+/** Carry the OIDC flow through each signup page. */
+export function signupPath(
+	/** @type {'/signup' | '/signup/add-passkey' | '/login'} */ path,
+	/** @type {string | null | undefined} */ returnPath
+) {
+	const destination = signupReturnPath(returnPath);
+	return destination === '/settings'
+		? path
+		: `${path}?${new URLSearchParams({ redirect: destination })}`;
+}
